              "color": "#fff"
            },
            "*": {
              "box-sizing": "border-box"
            },
            "body": {
              "font-family": "\"Open Sans\", sans-serif",
              "margin": "0",
              "padding": "5rem 1rem"
            },
            "p": {
              "margin": "0 0 1rem"
            },
            "img": {
              "display": "block",
              "width": "100%",
              "border-radius": "(@radius * 1px)",
              "-webkit-border-radius": "(@radius * 1px)",
              "-moz-border-radius": "(@radius * 1px)"
            },
            ".flex-container": {
              "max-width": "(@CardSize * 1rem)",
              "margin": "0 auto 5rem auto",
              "filter": "drop-shadow((@DecalX * 1px) (@DecalY * 1px) (@Flou * 1px) @CardShColor)"
            },
            ".col": {
              "position": "relative"
            },
            ".col--img": {
              "flex": "0 0 (@ImgSize * 1%)",
              "align-self": "flex-start"
            },
            ".col--text": {
              "background-color": "@CardColor",
              "padding": "1rem",
              "display": "flex",
              "flex-direction": "column",
              "position": "relative",
              "border-radius": "(@Cardradius * 1px)",
              "-webkit-border-radius": "(@Cardradius * 1px)",
              "-moz-border-radius": "(@Cardradius * 1px)"
            },
            "@media (min-width: 40em)": {
              "h3": {
                "font-size": "2rem"
              },
              ".flex-container": {
                "display": "flex"
              },
              ".col--text": {
                "padding": "2rem 4rem",
                "margin-top": "2rem",
                "margin-left": "-2rem",
                "z-index": "-1"
              }
            },
            ".mbr-section-subtitle": {
