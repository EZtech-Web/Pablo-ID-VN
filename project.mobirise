              "position": "absolute",
              "width": "90%",
              "height": "50%px",
              "left": "10px",
              "top": "10px",
              "background": "black",
              "overflow": "hidden",
              "border": "solid 3px black"
            },
            "#carousel figure:nth-child(1)": {
