              },
              "& when (@transp)": {
                "background": "transparent"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section": {
              "text-align": "center",
              "color": "#fff"
            },
            "#mu-about": {
              "background-color": "#fff",
              "display": "inline",
              "float": "left",
              "width": "100%"
