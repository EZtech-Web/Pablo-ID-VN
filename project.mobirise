      "components": [
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 15px)",
            "padding-bottom": "(@paddingBottom * 15px)",
            "& when (@bg-type = 'color')": {
              "& when not (@transp)": {
                "background": "linear-gradient(@angle * 1deg, @bg-value, @color2)"
              },
              "& when (@transp)": {
                "background": "transparent"
              }
            },
            "& when (@bg-type = 'image')": {
              "background-image": "url(@bg-value)"
            },
            ".mbr-section": {
              "text-align": "center",
              "color": "#fff"
            },
            "#mu-about": {
              "background-color": "#fff",
              "display": "inline",
              "float": "left",
              "width": "100%"
            },
            ".mu-about-area": {
              "display": "inline",
              "float": "left",
              "padding": "100px 0",
              "width": "100%"
            },
            ".mu-about-left": {
              "display": "inline",
              "float": "left",
              "width": "100%"
            },
            ".mu-about-right": {
              "display": "inline",
              "float": "left",
              "margin-top": "35px",
              "width": "130%",
              "background-color": "@bgCardColor",
              "padding": "40px",
              "margin-left": "-175px",
              "box-shadow": "(@LeRi * 1px) (@UpDo * 1px) (@Flou * 1px) (@FlouInt * 1px) @ShadowColor"
            },
            ".mu-about-right p": {
              "font-size": "15px"
            },
            "img": {
              "border": "none",
              "max-width": "100%"
            },
            "@media (max-width: 1199px)": {
              ".mu-about-right": {
                "margin-top": "20px",
                "width": "140%",
                "padding": "25px",
                "margin-left": "-190px"
              }
            },
            "@media (max-width: 991px)": {
              ".mu-about-left img": {
                "max-width": "none",
                "width": "115%"
              },
              ".mu-about-right": {
                "margin-top": "75px",
                "width": "160%",
                "padding": "20px",
                "margin-left": "-190px"
              },
              ".mu-about-right p": {
                "font-size": "14px"
              }
            },
            "@media (max-width: 767px)": {
              ".mu-about-area": {
                "padding": "50px 0"
              },
              ".mu-about-left img": {
                "max-width": "100%",
                "width": "auto"
              },
              ".mu-about-right": {
                "margin-top": "30px",
                "width": "100%",
                "padding": "0",
                "margin-left": "0",
                "box-shadow": "none"
              },
              ".mu-about-right p": {
                "font-size": "15px"
              }
            },
            ".mbr-section-subtitle": {
              "text-align": "left",
              "color": "#232323"
            },
            "P": {
              "text-align": "left",
              "color": "#232323"
            }
          },
          "_name": "design-block",
          "_customHTML": "<section data-bs-version=\"5.1\" mbr-id=\"_anchor\" class=\"mbr-section article content1\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n                   <header>Card</header>\n      \n        <input type=\"color\" title=\"Background Color\" name=\"bgCardColor\" value=\"#ffffff\">\n                <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\">\n         <input type=\"range\" inline title=\"Left/Right\" name=\"LeRi\" min=\"-20\" max=\"20\" step=\"1\" value=\"15\">\n         <input type=\"range\" inline title=\"Up/Down\" name=\"UpDo\" min=\"-20\" max=\"20\" step=\"1\" value=\"20\">\n         <input type=\"range\" inline title=\"Blur\" name=\"Flou\" min=\"-1\" max=\"25\" step=\"1\" value=\"22\">\n         <input type=\"range\" inline title=\"Blur Intensity\" name=\"FlouInt\" min=\"-16\" max=\"16\" step=\"1\" value=\"-7\">\n         <input type=\"color\" title=\"Shadow Color\" name=\"ShadowColor\" value=\"#232323\">\n         \n<header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"https://www.unsitepourtous.be/mobi/lionaf.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#a0e1e1\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n        \n         <input type=\"color\" title=\"Color 2\" name=\"color2\" value=\"#232323\" condition=\"bg.type == 'color'\">\n         <input type=\"range\" name=\"angle\" title=\"Angle\" min=\"0\" max=\"270\" value=\"0\" step=\"1\" condition=\"bg.type == 'color'\">\n\t\t <input type=\"checkbox\" title=\"Background Transparent\" name=\"transp\" condition=\"bg.type == 'color'\">\n\t\t\n\t\t\n\t\t        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n          \n    <!-- End block parameters -->\n    </mbr-parameters> \n\t\t        <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\">\n    </div>\n\t\t\t<div class=\"container\">\n\t\t\t\t<div class=\"row\">\n\t\t\t\t\t<div class=\"col-md-12\">\n\t\t\t\t\t\t<div class=\"mu-about-area\">\n\t\t\t\t\t\t\t<!-- Start Feature Content -->\n\t\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t\t<div class=\"col-md-6\">\n\t\t\t\t\t\t\t\t\t<div class=\"mu-about-left\">\n\t\t\t\t\t\t\t\t\t\t<img class src=\"@PROJECT_PATH@/assets/images/lucifer-nazi.jpg\" alt=\"Pablo_Anja\">\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"col-md-6\">\n\t\t\t\t\t\t\t\t\t<div class=\"mu-about-right\">\n\t\t\t\t\t\t\t\t\t\t<h2 data-app-selector=\".mbr-section-subtitle\" class=\"mbr-section-subtitle align-center mbr-light mbr-fonts-style\" mbr-theme-style=\"display-4\">Wz Pablo</h2>\n\t\t\t\t\t\t\t\t\t\t<p class=\"align-center mbr-fonts-style\" mbr-theme-style=\"display-7\">Xin chào - Tôi là \"Pablo\" (nó được lắp ghép từ tên họ của tôi, hay chúng tôi nghĩ vậy 🤗), và bây giờ tôi sẽ kể cho bạn nghe câu chuyện đã đưa tôi đến đây, đến hình ảnh phản chiếu trong võng mạc của bạn, độc giả thân mến của tôi.<br><br>Tôi sẽ kể cho bạn nghe một chút về bản thân mình - Tôi đã khoảng một phần ba thế kỷ (Gen.X), tôi là một gã lữ hành vũ trụ 🤣, hay đúng hơn là người du hành không thời gian. Và tôi cùng với nhóm làm việc của mình đã thực hiện các khám phá cũng như phát triển những mô hình sự sống trong nhiều chiều không thời gian khác nhau... và...<br><br>[Xem tiếp ở mục \"Câu Chuyện\"]</p>\n\t\t\t\t\t\t\t\t\t           <div class=\"mbr-section-btn align-center\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-md btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n           <span class=\"mbr-iconfont mbri-file\"></span>EN SAVOIR PLUS</a></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<!-- End Feature Content -->\n\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n</section>",
          "_cid": "aa47ZVex5S",
          "_anchor": "design-block-aa47ZVex5S",
          "_sourceTheme": "startm5",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    }
  }
