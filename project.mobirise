          "_name": "design-block",
          "_customHTML": "<section data-bs-version=\"5.1\" mbr-id=\"_anchor\" class=\"mbr-section article content1\" data-bg-video=\"{{bg.type == 'video'&&bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n\n    <mbr-parameters>\n    <!-- Block parameters controls (Blue \"Gear\" panel) -->\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"0\">\n                   <header>Card</header>\n      \n        <input type=\"color\" title=\"Background Color\" name=\"bgCardColor\" value=\"#ffffff\">\n                <input type=\"checkbox\" title=\"Show Buttons\" name=\"showButtons\">\n         <input type=\"range\" inline title=\"Left/Right\" name=\"LeRi\" min=\"-20\" max=\"20\" step=\"1\" value=\"15\">\n         <input type=\"range\" inline title=\"Up/Down\" name=\"UpDo\" min=\"-20\" max=\"20\" step=\"1\" value=\"20\">\n         <input type=\"range\" inline title=\"Blur\" name=\"Flou\" min=\"-1\" max=\"25\" step=\"1\" value=\"22\">\n         <input type=\"range\" inline title=\"Blur Intensity\" name=\"FlouInt\" min=\"-16\" max=\"16\" step=\"1\" value=\"-7\">\n         <input type=\"color\" title=\"Shadow Color\" name=\"ShadowColor\" value=\"#232323\">\n         \n<header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Background Image\" value=\"https://www.unsitepourtous.be/mobi/lionaf.jpg\">\n            <input type=\"color\" title=\"Background Color\" value=\"#a0e1e1\" selected>\n            <input type=\"video\" title=\"Background Video\" value=\"http://www.youtube.com/watch?v=uNCr7NdOJgw\">\n      </fieldset>\n        \n         <input type=\"color\" title=\"Color 2\" name=\"color2\" value=\"#232323\" condition=\"bg.type == 'color'\">\n         <input type=\"range\" name=\"angle\" title=\"Angle\" min=\"0\" max=\"270\" value=\"0\" step=\"1\" condition=\"bg.type == 'color'\">\n\t\t <input type=\"checkbox\" title=\"Background Transparent\" name=\"transp\" condition=\"bg.type == 'color'\">\n\t\t\n\t\t\n\t\t        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\">\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#232323\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.3\" condition=\"overlay && bg.type !== 'color'\">\n          \n    <!-- End block parameters -->\n    </mbr-parameters> \n\t\t        <div class=\"mbr-overlay\" mbr-if=\"overlay&&bg.type !== 'color'\" opacity=\"{{overlayOpacity}}\" bg-color=\"{{overlayColor}}\">\n    </div>\n\t\t\t<div class=\"container\">\n\t\t\t\t<div class=\"row\">\n\t\t\t\t\t<div class=\"col-md-12\">\n\t\t\t\t\t\t<div class=\"mu-about-area\">\n\t\t\t\t\t\t\t<!-- Start Feature Content -->\n\t\t\t\t\t\t\t<div class=\"row\">\n\t\t\t\t\t\t\t\t<div class=\"col-md-6\">\n\t\t\t\t\t\t\t\t\t<div class=\"mu-about-left\">\n\t\t\t\t\t\t\t\t\t\t<img class src=\"@PROJECT_PATH@/assets/images/universe-metime.jpg\" alt=\"Universe_MeTime\">\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t<div class=\"col-md-6\">\n\t\t\t\t\t\t\t\t\t<div class=\"mu-about-right\">\n\t\t\t\t\t\t\t\t\t\t<h2 data-app-selector=\".mbr-section-subtitle\" class=\"mbr-section-subtitle align-center mbr-light mbr-fonts-style\" mbr-theme-style=\"display-4\">Uz Pablo</h2>\n\t\t\t\t\t\t\t\t\t\t<p class=\"align-center mbr-fonts-style\" mbr-theme-style=\"display-7\">\n                    \"Họ\" sẽ phải mất bao nhiêu tỷ đô-la, bao nhiêu nhân lực và bao nhiêu nguồn tài nguyên khác... của cái thế giới này cho việc tạo dựng từ một thực thể \"Chosen One\" (Người Được Chọn) để trở thành một nhân tố \"Zone Master\" (Lãnh Đạo Vùng) trong những không gian hỗn độn gọi là \"War Zone\" (Vùng Chiến Sự)... ?<br><br><img border=\"0\" data-original-height=\"720\" data-original-width=\"720\" height=\"100%\" src=\"https://eztech-web.github.io/Pablo-ID-VN/assets/images/U3i.jpeg\" width=\"100%\" style=\"float: none; width: 100%;\" class><br>Chúng ta có lẽ chưa từng thấy hoặc chưa từng được chứng kiến việc thống kê này, hay những hoạt động sâu bên trong hệ thống của \"Họ\", nhưng nó vẫn đang diễn ra... mỗi một giây trôi qua của dòng thời gian là những sự kiện, những biến đổi từ hệ thống đi ra thế giới thực tại bên ngoài... Và liệu rằng đó có là tất cả những gì chúng ta đã biết ?<br>\n                    <br><img border=\"0\" data-original-height=\"720\" data-original-width=\"720\" height=\"100%\" src=\"https://eztech-web.github.io/Pablo-ID-VN/assets/images/U3z.jpeg\" width=\"100%\" style=\"width: 100%; float: none;\"></p>\n\t\t\t\t\t\t\t\t\t           <div class=\"mbr-section-btn align-center\" mbr-if=\"showButtons\" data-toolbar=\"-mbrBtnMove\" mbr-buttons mbr-theme-style=\"display-4\"><a class=\"btn btn-md btn-primary\" href=\"https://mobiri.se\" data-app-placeholder=\"Type Text\">\n           <span class=\"mbr-iconfont mbri-file\"></span>EN SAVOIR PLUS</a></div>\n\t\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t</div>\n\t\t\t\t\t\t\t<!-- End Feature Content -->\n\n\t\t\t\t\t\t</div>\n\t\t\t\t\t</div>\n\t\t\t\t</div>\n\t\t\t</div>\n</section>",
