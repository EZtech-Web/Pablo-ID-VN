            },
            ".mu-about-left": {
              "display": "inline",
              "float": "left",
              "width": "100%"
            },
            ".mu-about-right": {
              "display": "inline",
              "float": "left",
              "position": "sticky",
              "margin-top": "35px",
              "width": "130%",
              "background-color": "@bgCardColor",
              "padding": "40px",
              "margin-left": "-175px",
              "box-shadow": "(@LeRi * 1px) (@UpDo * 1px) (@Flou * 1px) (@FlouInt * 1px) @ShadowColor"
            },
